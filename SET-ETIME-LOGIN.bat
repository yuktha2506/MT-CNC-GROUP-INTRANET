@echo off
title Server-Plant - save eTimeTrack sign-in
rem ===== eTimeTrack sign-in for the Biometric attendance tiles =====
rem Edit these three lines if the address, ID or password ever change.
rem (If a password contains a percent sign, type it twice: %% )
set "SL_URL=http://time.microtechcnc.in:9002/Main.aspx"
set "SL_USER=itadmin"
set "SL_PASS=Itadmin@123"
rem =================================================================

net session >nul 2>&1
if %errorlevel% neq 0 ( powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs" & exit /b )
set "SL_DIR=%~dp0"
if "%SL_DIR:~-1%"=="\" set "SL_DIR=%SL_DIR:~0,-1%"

echo.
echo 1/3  Saving the eTimeTrack sign-in into .env
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 (
  echo.
  echo  Nothing was changed. Take a photo of this window and send it to Claude.
  pause
  exit /b 1
)

echo.
echo 2/3  Restarting the Node backend (task Server-Plant)
schtasks /End /TN "Server-Plant" >nul 2>&1
powershell -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name='node.exe'\" | Where-Object { $_.CommandLine -match 'backend\.js' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }"
timeout /t 2 /nobreak >nul
schtasks /Run /TN "Server-Plant" >nul
timeout /t 6 /nobreak >nul

echo.
echo 3/3  Checking the backend
powershell -NoProfile -Command "try { Invoke-WebRequest http://127.0.0.1:3000/api/attendance/summary -UseBasicParsing | Out-Null; '  OK' } catch { $c = 0; if ($_.Exception.Response) { $c = [int]$_.Exception.Response.StatusCode }; if ($c -eq 401) { '  OK - backend is running with the eTimeTrack reader. Refresh the Today page in 30 seconds.' } elseif ($c -eq 404) { '  The running api.js is OLD - copy the new api.js into ' + $env:SL_DIR + ' and run FIX-ATTENDANCE.bat.' } elseif ($c -eq 0) { '  Node is NOT answering - see logs\server.log' } else { '  Backend answered HTTP ' + $c } }"
echo.
pause
