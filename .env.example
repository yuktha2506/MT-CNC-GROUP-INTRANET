# Copy to .env on the server. Never commit .env or put these values in frontend.html.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# The specified IIS binding is HTTP. Set true only after IIS HTTPS is enabled.
COOKIE_SECURE=false
# Production requires an explicit bcrypt hash for the configured employee password.
EMPLOYEE_PASSWORD_HASH=replace-with-a-bcrypt-hash
# Optional. Leave unset for same-origin IIS hosting.
# FRONTEND_ORIGIN=https://intranet.example.com
